{
  "name": "@commercetools/nimbus-viz",
  "version": "0.0.0",
  "description": "Data visualization library for the Nimbus design system",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/commercetools/nimbus.git"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "gallery": "vite",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@commercetools/nimbus-tokens": "workspace:*",
    "@visx/axis": "catalog:viz",
    "@visx/curve": "catalog:viz",
    "@visx/glyph": "catalog:viz",
    "@visx/gradient": "catalog:viz",
    "@visx/grid": "catalog:viz",
    "@visx/group": "catalog:viz",
    "@visx/heatmap": "catalog:viz",
    "@visx/hierarchy": "catalog:viz",
    "@visx/legend": "catalog:viz",
    "@visx/network": "catalog:viz",
    "@visx/responsive": "catalog:viz",
    "@visx/sankey": "catalog:viz",
    "@visx/scale": "catalog:viz",
    "@visx/shape": "catalog:viz",
    "@visx/stats": "catalog:viz",
    "@visx/text": "catalog:viz",
    "@visx/tooltip": "catalog:viz",
    "d3-array": "catalog:viz",
    "d3-format": "catalog:viz",
    "d3-time-format": "catalog:viz"
  },
  "peerDependencies": {
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "devDependencies": {
    "@types/d3-array": "catalog:viz",
    "@types/d3-format": "catalog:viz",
    "@types/d3-time-format": "catalog:viz",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitejs/plugin-react": "catalog:tooling",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "tsup": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:tooling"
  }
}
